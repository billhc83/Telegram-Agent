    },
    {
      "parameters": {
        "jsCode": "const sys = 'Write a GitHub PR description. Format: first line is the title (max 70 chars, no prefix), then blank line, then ## Summary (3 bullet points), then ## Changes (technical detail). Markdown. No preamble.'; const t = $input.first().json; const userMsg = 'Branch: ' + t.branch + '\\n\\nDiff summary:\\n' + t.diff_summary; return [{ json: { model: 'qwen2.5:14b', messages: [{ role: 'system', content: sys }, { role: 'user', content: userMsg }], stream: false, options: { temperature: 0.1 } } }];"
      },
      "id": "00000008-0002-4000-0000-000000000008",
      "name": "Build Body",
