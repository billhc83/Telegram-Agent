   "id": "a1000008-0000-4000-0000-000000000008",
   "name": "Translate Title",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    900,
    300
   ],
   "onError": "continueRegularOutput",
   "parameters": {
    "method": "POST",
    "url": "http://host.docker.internal:11434/api/chat",
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify({\n  model: 'qwen3-14b-nothink:latest',\n  stream: false,\n  think: false,\n  options: { num_ctx: 2048, temperature: 0 },\n  messages: [\n    { role: 'system', content: \"You translate Japanese Yahoo Auctions listing titles into English for a buyer who cannot read Japanese. The listings are mostly parts, accessories and literature for Suzuki kei cars (Cappuccino EA11R, Cara and AZ-1 PG6SS/PG6SA) and similar Japanese cars. Katakana words that are car model names, for example キャラ (Cara), カプチーノ (Cappuccino), アルト (Alto), ジムニー (Jimny), are model names: transliterate them, never translate them as ordinary words. Keep part numbers, model codes and chassis codes (EA11R, PG6SS, F6A, AZ-1, 35501-69DA0 and so on) exactly as written. Translate condition and fitment words literally (ジャンク = junk / for parts, 未使用 = unused, 純正 = genuine OEM). Do not add any information that is not in the title. Reply with the English translation only, on one line.\" },\n    { role: 'user', content: String($json.title || '').trim() }\n  ]\n}) }}",
    "options": {
     "timeout": 180000
    }
   }
  },
  {
   "id": "a1000009-0000-4000-0000-000000000009",
   "name": "Build Message",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1120,
    300
   ],
   "parameters": {
    "mode": "runOnceForEachItem",
    "jsCode": "var i = $('Split Out').item.json;\nvar esc = function(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); };\nvar yen = function(n) { return '¥' + Number(n).toLocaleString('en-US'); };\nvar jp = String(i.title || '').trim();\nvar img = (i.image_stored === false && i.image_source) ? i.image_source : (i.image || '');\nvar tr = '';\nif ($json && $json.message && typeof $json.message.content === 'string') {\n  tr = $json.message.content.replace(/<think>[\\s\\S]*?<\\/think>/g, '').trim().split('\\n')[0].trim().slice(0, 300);\n}\nvar end = new Date(i.end_time * 1000).toLocaleString('ja-JP', { timeZone: 'Asia/Tokyo' });\nvar isBin = i.type === 'buy_it_now';\nvar head = (tr && tr !== jp) ? '<b>' + esc(tr) + '</b>\\n' + esc(jp) : '<b>' + esc(jp) + '</b>';\nvar lines = [\n  (isBin ? '🛒 Buy it now' : '🔨 Auction'),\n  head,\n  '',\n  'Price: ' + yen(i.price) + ((i.buynow_price > 0 && !isBin) ? '  |  Buy now: ' + yen(i.buynow_price) : ''),\n  'Ends: ' + esc(end) + ' JST',\n  'Watch: ' + esc(i.watch_query),\n  '',\n  '<a href=\"' + esc(i.url) + '\">' + esc(i.url) + '</a>'\n];\nreturn { json: { auction_id: i.auction_id, image: img, caption: lines.join('\\n'), translated: !!tr } };\n"
   }
  },
  {
