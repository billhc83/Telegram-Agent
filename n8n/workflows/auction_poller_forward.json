   ],
   "parameters": {
    "method": "POST",
    "url": "http://host.docker.internal:8765/api/items/ack",
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify({ ids: [ $('Split Out').item.json.auction_id ] }) }}",
    "options": {
     "timeout": 30000
    }
   }
  }
 ],
