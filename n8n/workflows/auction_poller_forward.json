  {
   "id": "a1000004-0000-4000-0000-000000000004",
   "name": "Send Auction Alert",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    900,
    300
   ],
   "onError": "continueRegularOutput",
   "parameters": {
    "method": "POST",
    "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ (function() {\n  var esc = s => String(s == null ? '' : s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\n  var i = $json;\n  var yen = function(n) { return '¥' + Number(n).toLocaleString('en-US'); };\n  var end = new Date(i.end_time * 1000).toLocaleString('ja-JP', { timeZone: 'Asia/Tokyo' });\n  var lines = [\n    '🔨 <b>' + esc(i.title) + '</b>',\n    '',\n    'Price: ' + yen(i.price) + (i.buynow_price > 0 ? '  |  Buy now: ' + yen(i.buynow_price) : ''),\n    'Ends: ' + esc(end) + ' JST',\n    'Watch: ' + esc(i.watch_query),\n    '',\n    '<a href=\"' + esc(i.url) + '\">' + esc(i.url) + '</a>'\n  ];\n  return JSON.stringify({ chat_id: $env.TELEGRAM_CHAT_ID, text: lines.join('\\n'), parse_mode: 'HTML' });\n})() }}",
    "options": {
     "batching": {
      "batch": {
       "batchSize": 1,
       "batchInterval": 1100
      }
     }
    }
   }
  },
  {
   "id": "a1000005-0000-4000-0000-000000000005",
   "name": "Sent OK?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 2,
   "position": [
    1120,
    300
   ],
   "parameters": {
    "conditions": {
     "options": {
      "caseSensitive": true,
      "leftValue": "",
      "typeValidation": "loose"
     },
     "conditions": [
      {
       "id": "c1",
       "leftValue": "={{ $json.ok }}",
       "rightValue": "",
       "operator": {
        "type": "boolean",
        "operation": "true",
        "singleValue": true
       }
      }
     ],
     "combinator": "and"
    },
    "options": {}
   }
  },
  {
   "id": "a1000006-0000-4000-0000-000000000006",
   "name": "Ack Item",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    1340,
