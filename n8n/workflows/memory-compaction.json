      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://qdrant:6333/collections/agent_memory/points/scroll",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "limit",
              "value": "500"
            },
            {
              "name": "with_payload",
              "value": "true"
            },
            {
              "name": "with_vector",
              "value": "false"
            }
          ]
        },
        "options": {}
      },
      "id": "comp-0002-aaaa-bbbb-cccc-ddddeeeeffffgg",
      "name": "Fetch Recent Points",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const points = $input.item.json.result?.points ?? [];\nconst texts = points.map(p => {\n  try {\n    const c = JSON.parse(p.payload?.content ?? '{}');\n    return c.text ?? '';\n  } catch {\n    return p.payload?.text ?? '';\n  }\n}).filter(Boolean);\nreturn { json: { conversation_dump: texts.join('\\n---\\n'), point_ids: points.map(p => p.id) } };"
      },
      "id": "comp-0003-aaaa-bbbb-cccc-ddddeeeeffffgg",
      "name": "Flatten Texts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Below are recent conversation snippets from a Telegram AI assistant. Condense them into a compact summary that preserves: (1) user preferences and recurring topics, (2) ongoing projects or tasks, (3) any facts the user explicitly stated about themselves. Be brief. Remove duplicate or trivial exchanges.\n\n---\n{{ $json.conversation_dump }}",
        "options": {
          "systemMessage": "You are a memory compaction assistant. Output only the condensed summary \u2014 no preamble."
        }
      },
      "id": "comp-0004-aaaa-bbbb-cccc-ddddeeeeffffgg",
      "name": "Summarize with Ollama",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
