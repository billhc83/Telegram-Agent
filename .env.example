# ── Secrets ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=change_me_strong_password
N8N_ENCRYPTION_KEY=change_me_32_char_encryption_key

# ── Telegram ────────────────────────────────────────────────────────────────
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCDefGhIjKlMnOpQrStUvWxYz

# ── OpenRouter ──────────────────────────────────────────────────────────────
# Get from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# ── n8n webhook URL ─────────────────────────────────────────────────────────
# Public URL n8n is reachable at (needed for Telegram webhook delivery).
# If running locally, use ngrok: ngrok http 5678
N8N_WEBHOOK_URL=https://your-domain.com/

# ── Timezone ────────────────────────────────────────────────────────────────
TIMEZONE=Europe/London

# ── MCP: Filesystem ─────────────────────────────────────────────────────────
# Absolute path on the host that the filesystem MCP server exposes
FILESYSTEM_WORKSPACE=./workspace

# ── MCP: Gmail ──────────────────────────────────────────────────────────────
# Directory containing your GCP OAuth credentials JSON files.
# See scripts/setup-gmail-oauth.md for how to create these.
GMAIL_CREDENTIALS_DIR=./credentials/gmail
